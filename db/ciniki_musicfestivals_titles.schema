#
# Description
# -----------
# This table stores the song selections available for different sections
#
# Fields
# ------
# id:                       The ID assigned to the record.
# uuid:                     The Universal Unique ID.
# tnid:                     The Tenant ID the record belongs to.
#
# list_id:                  The ID of the list the title is a part of.
# title:                    The title of the piece. 
# opus:                     The opus of the piece.
# movements:                The movements of the piece.
# musical:                  The musical/tv show/movie.
# composer:                 The composer of the piece.
# arranger:                 The arranger of the piece.
#
# source_type:              The type or media source where this is from, typically only used for ssam.
# keywords:                 The keywords for this piece.
#
# date_added:               The UTC date and time the record was added.
# last_updated:             The UTC date and time the record was last update.
#
create table ciniki_musicfestivals_titles (
    id int not null auto_increment,
    uuid char(36) not null,
    tnid int not null,

    list_id int not null,
    fulltitle varchar(500) not null,
    title varchar(200) not null,
    opus varchar(150) not null,
    movements varchar(150) not null,
    musical varchar(150) not null,
    composer varchar(150) not null,
    arranger varchar(150) not null,
    source_type varchar(100) not null,
    keywords varchar(1000) not null,

    date_added datetime not null,
    last_updated datetime not null,
    primary key (id),
    unique index (uuid),
    unique index (list_id, fulltitle, source_type),
    index (keywords),
    index sync (tnid, uuid, last_updated)
) ENGINE='InnoDB', COMMENT='v1.03';
